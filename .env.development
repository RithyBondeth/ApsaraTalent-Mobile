# Development Environment Variables
APP_ENV=development
# The local API gateway (ApsaraTalent-Api: docker compose -f docker-compose.dev.yml
# up -d, then the gateway, auth and user services). This used to point at the
# production API, so every debug build signed in against real accounts.
#
# 127.0.0.1 reaches the host from the iOS simulator. The Android emulator
# needs 10.0.2.2 for the same host; a physical device needs the machine's LAN
# address.
API_BASE_URL=http://127.0.0.1:3000
DEBUG_MODE=true
